import:
    ch.njol.skript.Skript
    java.io.ByteArrayInputStream
    java.net.URI
    java.net.http.HttpClient
    java.net.http.HttpClient$Redirect
    java.net.http.HttpRequest
    java.net.http.HttpResponse$BodyHandlers
    java.nio.file.Files
    java.nio.file.Path
    java.nio.file.StandardOpenOption
    java.util.zip.ZipInputStream
    org.bukkit.Bukkit

options:
    bracket: <##566c86>
    brand: <##ef7d57>
    body: <##c0c6cc>
    link: <##41a6f6>
    ok: <##38b764>
    warn: <##ffcd75>
    error: <##b13e53>

on load:
    set {-pacskage::scripts_root} to "%Skript.getInstance().getDataFolder().getCanonicalPath()%/scripts"
    set {-pacskage::packages_root} to "%{-pacskage::scripts_root}%/packages"
    set {-pacskage::self_path} to "%{-pacskage::scripts_root}%/package.sk"
    set {-pacskage::plugin_manager} to Bukkit.getPluginManager()
    set {-pacskage::http_client} to HttpClient.newBuilder().followRedirects(Redirect.NORMAL).build()
    set {-pacskage::body_handler} to BodyHandlers.ofByteArray()
    set {-pacskage::append_options} to [StandardOpenOption.CREATE, StandardOpenOption.APPEND]
    set {-pacskage::write_options} to [StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING]
    set {-pacskage::commands::*} to "install <git url>[@version][#subfolder]", "update <name>", "remove <name>", "enable <name>", "disable <name>", "info <name>", "list", "check", "outdated", "selfupdate" and "awesome"

local function sub(text: String, start: Integer, end: Integer = -1) -> String:
    if {_end} < 0:
        set {_end} to length of {_text}
    return subtext of {_text} from {_start} to {_end}

local function trim(text: String) -> String:
    set {_text} to {_text}.trim()
    if length of {_text} > 0:
        return {_text}

local function first_word(text: String) -> String:
    return first element of (split {_text} at " ")

local function pkg_sub(url: String) -> String:
    set {_parts::*} to split {_url} at "#"
    if size of {_parts::*} < 2:
        stop
    set {_path} to trim({_parts::2})
    if {_path} is not set:
        stop
    while {_path} ends with "/":
        set {_path} to first ((length of {_path}) - 1) characters of {_path}
    if length of {_path} <= 0:
        stop
    return {_path}

local function pkg_url_base(url: String) -> String:
    return first element of (split {_url} at "#")

# Only an @ in the final path segment is a ref.
local function pkg_ref(url: String) -> String:
    set {_url} to pkg_url_base({_url})
    set {_last} to last element of (split {_url} at "/")
    if {_last} does not contain "@":
        stop
    set {_ref} to trim(last element of (split {_last} at "@"))
    if {_ref} is not set:
        stop
    return {_ref}

local function repo_url(url: String) -> String:
    set {_sub} to pkg_sub({_url})
    set {_url} to pkg_url_base({_url})
    set {_ref} to pkg_ref({_url})
    if {_ref} is set:
        set {_url} to first (((length of {_url}) - (length of {_ref})) - 1) characters of {_url}
    if {_url} ends with "/":
        set {_url} to first ((length of {_url}) - 1) characters of {_url}
    if {_url} ends with ".git":
        set {_url} to first ((length of {_url}) - 4) characters of {_url}
    if {_sub} is set:
        return "%{_url}%#%{_sub}%"
    return {_url}

# Public API.
function pkg_name(url: String) -> String:
    set {_name} to (last element of (split (pkg_sub({_url}) ? repo_url({_url})) at "/"))
    if {_name} ends with ".zip":
        set {_name} to first (length of {_name} - 4) characters of {_name}
    if any:
        length of {_name} <= 0
        {_name} is "." or ".."
        {_name} starts with "-"
        {_name} contains "~"
    then:
        stop
    return {_name}

local function pkg_zip_url(url: String) -> String:
    set {_url} to pkg_url_base({_url})
    if {_url} ends with ".zip":
        return {_url}
    set {_ref} to (pkg_ref({_url}) ? "HEAD")
    return "%repo_url({_url})%/archive/%{_ref}%.zip"

local function pkg_dir(name: String) -> String:
    return "%{-pacskage::packages_root}%/%{_name}%"

local function pkg_disabled_dir(name: String) -> String:
    return "%{-pacskage::packages_root}%/-%{_name}%"

local function pkg_tmp_dir(name: String) -> String:
    return (Path.of("%{-pacskage::scripts_root}%/../.pacskage-tmp-%{_name}%").normalize().toString())

local function pkg_display(folder: String) -> String:
    set {_lines::*} to manifest_lines(pkg_dir({_folder}))
    set {_origin} to manifest_value({_lines::*}, "origin")
    set {_version} to manifest_value({_lines::*}, "version")
    set {_suffix} to ""
    if {_version} is set:
        set {_suffix} to " v%{_version}%"
    set {_name} to pkg_bare({_folder})
    if {_folder} does not start with "-":
        return "%pkg_link({_name}, {_origin})%%{_suffix}%"
    return "%pkg_link({_name}, {_origin})%%{_suffix}% (disabled)"

local function strip_root(path: String) -> String:
    set {_slash} to first index of "/" in {_path}
    if {_slash} <= 0:
        stop
    set {_relative} to sub({_path}, ({_slash} + 1))
    if {_relative} is not set:
        stop
    return {_relative}

# numeric segment-wise compare, missing segments count as 0,
# pre-release suffixes are ignored (2.6.3-beta compares as 2.6.3)
local function version_at_least(version: String, minimum: String) -> Boolean:
    set {_have::*} to split (first element of (split {_version} at "-")) at "."
    set {_want::*} to split (first element of (split {_minimum} at "-")) at "."
    set {_count} to max(size of {_have::*}, size of {_want::*})
    loop {_count} times:
        set {_a} to (({_have::%loop-number%} parsed as integer) ? 0)
        set {_b} to (({_want::%loop-number%} parsed as integer) ? 0)
        if {_a} > {_b}:
            return true
        if {_a} < {_b}:
            return false
    return true

local function manifest_value(lines: Strings, key: String) -> String:
    for {_line} in {_lines::*}:
        set {_value} to manifest_line_value({_line}, {_key})
        if {_value} is set:
            return {_value}

local function manifest_line_value(line: String, key: String) -> String:
    set {_line} to trim({_line})
    if {_line} starts with "#":
        stop
    if {_line} does not start with "%{_key}%:":
        stop
    return trim(sub({_line}, (length of {_key} + 2)))

local function manifest_lines(dir: String) -> Strings:
    set {_path} to "%{_dir}%/package.txt"
    if dir_exists({_path}) = false:
        stop
    return (...Files.readAllLines(Path.of({_path})).toArray())

local function manifest(dir: String, key: String) -> String:
    return manifest_value(manifest_lines({_dir}), {_key})

local function pkg_msg(to: Object, message: String):
    send formatted "{@bracket}[{@brand}pacskage{@bracket}]<reset> {@body}%{_message}%" to {_to}

local function pkg_link(name: String, url: String) -> String:
    if {_url} is not set:
        return "{@link}%{_name}%{@body}"
    return "<click:open_url:%{_url}%>{@link}<underlined>%{_name}%</underlined></click>{@body}"

local function pkg_fail(message: String):
    set {-pacskage::error} to {_message}

local function pkg_error(fallback: String = "failed") -> String:
    set {_message} to {-pacskage::error}
    delete {-pacskage::error}
    return {_message} ? {_fallback}

local function dir_exists(path: String) -> Boolean:
    set {_path} to Path.of({_path})
    return Files.exists({_path})

local function dir_create(path: String):
    Files.createDirectories(Path.of({_path}))

local function dir_rename(from: String, to: String):
    Files.move(Path.of({_from}), Path.of({_to}))

local function pkg_list() -> Strings:
    if dir_exists({-pacskage::packages_root}) = false:
        stop
    set {_paths::*} to (...Files.list(Path.of({-pacskage::packages_root})).sorted().toArray())
    set {_dirs::*} to ({_paths::*} where [(Files.isDirectory(input)) is true])
    return ({_dirs::*} transformed with [(input.getFileName().toString())])

# deletes contents before their parent folders (deepest paths first)
local function dir_delete(path: String):
    set {_paths::*} to reversed (...Files.walk(Path.of({_path})).toArray())
    for {_path} in {_paths::*}:
        Files.delete({_path})

local function file_append_line(path: String, line: String):
    Files.writeString(Path.of({_path}), "%{_line}%%nl%", {-pacskage::append_options})

local function plugin_version(name: String) -> String:
    set {_plugin} to {-pacskage::plugin_manager}.getPlugin({_name})
    if {_plugin} is not set:
        stop
    return {_plugin}.getDescription().getVersion()

local function http_get(url: String) -> Object:
    set {_uri} to try URI.create({_url})
    set {_builder} to try HttpRequest.newBuilder({_uri})
    if {_builder} is not set:
        stop
    set {_request} to {_builder}.build()
    set {_response} to try {-pacskage::http_client}.send({_request}, {-pacskage::body_handler})
    if {_response} is not set:
        stop
    if {_response}.statusCode() != 200:
        stop
    return {_response}.body()

# extracts an archive into dest. a non-empty sub keeps only the files under
# that subfolder of the archive, re-rooted at it
local function zip_extract(bytes: Object, dest: String, url: String):
    set {_sub} to pkg_sub({_url}) ? ""
    set {_root} to Path.of({_dest})
    set {_zip} to new ZipInputStream(new ByteArrayInputStream({_bytes}))
    set {_entry} to {_zip}.getNextEntry()
    while {_entry} is set:
        zip_extract_entry({_zip}, {_entry}, {_root}, {-pacskage::write_options}, {_sub})
        set {_entry} to {_zip}.getNextEntry()
    {_zip}.close()

local function zip_extract_entry(zip: Object, entry: Object, root: Object, options: Object, sub: String):
    set {_relative} to strip_root({_entry}.getName())
    if {_relative} is not set:
        stop
    if length of {_sub} > 0:
        if {_relative} is "%{_sub}%/":
            stop
        if {_relative} does not start with "%{_sub}%/":
            stop
        set {_relative} to sub({_relative}, (length of {_sub} + 2))
    set {_target} to ({_root}.resolve({_relative}).normalize())
    if {_target}.startsWith({_root}) = false:
        stop
    if {_entry}.isDirectory() is true:
        Files.createDirectories({_target})
        stop
    Files.createDirectories({_target}.getParent())
    Files.write({_target}, {_zip}.readAllBytes(), {_options})

local function pkg_find_folder(name: String) -> String:
    return first element of ((pkg_list()) where [(pkg_bare(input)) is {_name}])

local function pkg_resolve(name: String) -> String:
    set {_folder} to pkg_find_folder({_name})
    if {_folder} is set:
        return pkg_dir({_folder})

local function pkg_installed(name: String) -> Boolean:
    return whether pkg_resolve({_name}) is set

local function requirement_missing(entry: String) -> String:
    set {_name} to trim(first element of (split {_entry} at ">="))
    if {_name} is not set:
        stop
    set {_installed} to plugin_version({_name})
    if {_installed} is not set:
        return "%{_name}% (not installed)"
    if {_entry} does not contain ">=":
        stop
    set {_min} to trim(last element of (split {_entry} at ">="))
    if version_at_least({_installed}, {_min}) is true:
        stop
    return "%{_name}% >= %{_min}% (installed: %{_installed}%)"

# Public API.
function pkg_by_origin(url: String) -> String:
    set {_url} to repo_url({_url})
    for {_folder} in pkg_list():
        set {_origin} to manifest(pkg_dir({_folder}), "origin")
        if {_origin} is not set:
            continue
        if repo_url({_origin}) is {_url}:
            return {_folder}

local function pkg_dep_missing(entry: String) -> String:
    set {_entry} to trim({_entry})
    if {_entry} is not set:
        stop
    if all:
        {_entry} contains "://"
        pkg_by_origin({_entry}) is set
    then:
        stop
    set {_dep} to pkg_name({_entry})
    if {_dep} is not set:
        stop
    if pkg_installed({_dep}) is true:
        stop
    return "package %{_dep}% (not installed)"

local function pkg_missing(dir: String) -> Strings:
    set {_lines::*} to manifest_lines({_dir})
    set {_requires::*} to split (manifest_value({_lines::*}, "requires") ? "") at ","
    set {_packages::*} to split (manifest_value({_lines::*}, "packages") ? "") at ","
    return (({_requires::*} transformed with [(requirement_missing(input))]) and ({_packages::*} transformed with [(pkg_dep_missing(input))]))

local function requirement_status(entry: String) -> String:
    set {_entry} to trim({_entry})
    if {_entry} is not set:
        return "  ?"
    set {_unmet} to requirement_missing({_entry})
    if {_unmet} is set:
        return "  missing: %{_unmet}%"
    return "  ok: %{_entry}%"

local function pkg_dep_status(entry: String) -> String:
    set {_entry} to trim({_entry})
    if {_entry} is not set:
        return "  ?"
    set {_unmet} to pkg_dep_missing({_entry})
    if {_unmet} is set:
        return "  missing: %{_unmet}%"
    return "  ok: %{_entry}%"

local function pkg_install_deps(dir: String, depth: Integer):
    set {_packages} to manifest({_dir}, "packages")
    if {_packages} is not set:
        stop
    for {_entry} in split {_packages} at ",":
        pkg_install_dep({_entry}, {_depth})

local function pkg_install_dep(entry: String, depth: Integer):
    set {_entry} to trim({_entry})
    if {_entry} is not set:
        stop
    if {_entry} does not contain "://":
        stop
    if pkg_by_origin({_entry}) is set:
        stop
    set {_dep} to pkg_name({_entry})
    if {_dep} is not set:
        stop
    if pkg_installed({_dep}) is true:
        stop
    set {_installed} to pkg_install({_entry}, ({_depth} + 1))
    if {_installed} is set:
        stop
    set {_reason} to pkg_error()
    pkg_msg(console, "package dependency %{_entry}%: %{_reason}%")

# downloads, extracts and registers one package; unmet requirements leave it
# installed disabled (-<name>). returns the final name, or nothing with the
# failure reason readable via pkg_error()
local function pkg_install(url: String, depth: Integer) -> String:
    if {_depth} > 5:
        pkg_fail("package dependencies nested too deep")
        stop
    set {_name} to pkg_name({_url})
    if {_name} is not set:
        pkg_fail("cannot derive a package name from %{_url}%")
        stop
    if pkg_installed({_name}) is true:
        pkg_fail("package %{_name}% is already installed")
        stop
    set {_zip} to pkg_zip_url({_url})
    set {_bytes} to http_get({_zip})
    if {_bytes} is not set:
        pkg_fail("download failed for %{_zip}%")
        stop
    set {_dest} to pkg_dir({_name})
    set {_sub} to pkg_sub({_url})
    dir_create({_dest})
    zip_extract({_bytes}, {_dest}, {_url})
    if all:
        {_sub} is set
        Files.list(Path.of({_dest})).findAny().isPresent() is false
    then:
        dir_delete({_dest})
        pkg_fail("archive does not contain subfolder %{_sub}%")
        stop
    set {_manifest} to manifest({_dest}, "name")
    if {_manifest} is set:
        set {_rename} to pkg_name({_manifest})
    if all:
        {_rename} is set
        {_rename} is not {_name}
    then:
        if pkg_installed({_rename}) is true:
            dir_delete({_dest})
            pkg_fail("package %{_rename}% is already installed")
            stop
        dir_rename({_dest}, pkg_dir({_rename}))
        set {_name} to {_rename}
        set {_dest} to pkg_dir({_name})
    pkg_install_deps({_dest}, {_depth})
    file_append_line("%{_dest}%/package.txt", "origin: %{_url}%")
    if pkg_missing({_dest}) is set:
        dir_rename({_dest}, pkg_disabled_dir({_name}))
    return {_name}

function pkg_install_report(sender: Object, url: String):
    pkg_msg({_sender}, "installing from %{_url}%...")
    set {_installed} to pkg_install({_url}, 0)
    if {_installed} is not set:
        pkg_msg({_sender}, pkg_error("install failed"))
        stop
    set {_disabled} to pkg_disabled_dir({_installed})
    if dir_exists({_disabled}) is true:
        pkg_msg({_sender}, "installed %{_installed}% disabled, missing: %pkg_missing({_disabled})%")
        pkg_msg({_sender}, "resolve the requirements, then run /package enable %{_installed}%")
        stop
    pkg_msg({_sender}, "installed %{_installed}% - /sk reload scripts to apply")

# re-downloads a package from its recorded origin and replaces the
# installed copy unless it already carries the newest version. returns a
# status message, or nothing with the reason readable via pkg_error()
local function pkg_update(name: String) -> String:
    set {_dir} to pkg_resolve({_name})
    if {_dir} is not set:
        pkg_fail("package %{_name}% is not installed")
        stop
    set {_lines::*} to manifest_lines({_dir})
    set {_origin} to manifest_value({_lines::*}, "origin")
    if {_origin} is not set:
        pkg_fail("package %{_name}% has no origin recorded")
        stop
    set {_bytes} to http_get(pkg_zip_url({_origin}))
    if {_bytes} is not set:
        pkg_fail("download failed for %pkg_zip_url({_origin})%")
        stop
    set {_tmp} to pkg_tmp_dir({_name})
    if dir_exists({_tmp}) is true:
        dir_delete({_tmp})
    dir_create({_tmp})
    zip_extract({_bytes}, {_tmp}, {_origin})
    if Files.list(Path.of({_tmp})).findAny().isPresent() is false:
        dir_delete({_tmp})
        pkg_fail("downloaded archive from %{_origin}% is empty")
        stop
    set {_current} to manifest_value({_lines::*}, "version")
    set {_remote} to manifest({_tmp}, "version")
    if all:
        {_current} is set
        {_remote} is set
        version_at_least({_current}, {_remote}) is true
    then:
        dir_delete({_tmp})
        return "package %{_name}% is already up to date (%{_current}%)"
    set {_dest} to pkg_dir({_name})
    dir_delete({_dir})
    dir_rename({_tmp}, {_dest})
    pkg_install_deps({_dest}, 0)
    file_append_line("%{_dest}%/package.txt", "origin: %{_origin}%")
    set {_version} to ""
    if {_remote} is set:
        set {_version} to " to %{_remote}%"
    if pkg_missing({_dest}) is set:
        dir_rename({_dest}, pkg_disabled_dir({_name}))
        return "updated %{_name}%%{_version}% disabled, missing: %pkg_missing(pkg_disabled_dir({_name}))%"
    return "updated %{_name}%%{_version}% - /sk reload scripts to apply"

local function pkg_bare(folder: String) -> String:
    set {_folder} to sub({_folder}, 2) if {_folder} starts with "-"
    return last element of (split {_folder} at "~")

local function pkg_reorder(sender: Object):
    set {_reorder} to function "pkg_reorder_by_load_order"
    if {_reorder} is not set:
        stop
    run {_reorder} with args script, {_sender}

local function pkg_check_line(folder: String) -> String:
    set {_name} to pkg_bare({_folder})
    set {_disabled} to whether {_folder} starts with "-"
    set {_dir} to pkg_dir({_folder})
    set {_link} to pkg_link({_name}, manifest({_dir}, "origin"))
    set {_missing::*} to pkg_missing({_dir})
    if all:
        {_disabled} is true
        {_missing::*} is not set
    then:
        return "{@ok}ready{@body}: %{_link}% - requirements met, run /package enable %{_name}%"
    if {_disabled} is true:
        return "disabled: %{_link}% - missing: %{_missing::*}%"
    if {_missing::*} is set:
        return "{@error}broken{@body}: %{_link}% - missing: %{_missing::*}%"
    return "ok: %{_link}%"

local function pkg_outdated_line(folder: String) -> String:
    set {_name} to pkg_bare({_folder})
    set {_dir} to pkg_dir({_folder})
    set {_lines::*} to manifest_lines({_dir})
    set {_origin} to manifest_value({_lines::*}, "origin")
    if {_origin} is not set:
        return "no origin: %{_name}% - cannot check"
    set {_link} to pkg_link({_name}, {_origin})
    set {_current} to manifest_value({_lines::*}, "version")
    set {_bytes} to http_get(pkg_zip_url({_origin}))
    if {_bytes} is not set:
        return "{@error}failed{@body}: %{_link}% - could not download from origin"
    set {_tmp} to pkg_tmp_dir({_name})
    if dir_exists({_tmp}) is true:
        dir_delete({_tmp})
    dir_create({_tmp})
    zip_extract({_bytes}, {_tmp}, {_origin})
    set {_remote} to manifest({_tmp}, "version")
    dir_delete({_tmp})
    if any:
        {_current} is not set
        {_remote} is not set
    then:
        return "unknown: %{_link}% - no version to compare"
    if version_at_least({_current}, {_remote}) is true:
        return "ok: %{_link}% (%{_current}%)"
    return "{@warn}outdated{@body}: %{_link}% (%{_current}% -> %{_remote}%)"

# overwrites the running package.sk with the latest from the repo. the path is
# fixed: pacskage always lives as package.sk at the scripts root
local function pkg_selfupdate(sender: Object):
    set {_url} to "https://raw.githubusercontent.com/miberss/pacskage/refs/heads/skript-minestom/package.sk"
    pkg_msg({_sender}, "updating pacskage from %{_url}%...")
    set {_bytes} to http_get({_url})
    if {_bytes} is not set:
        pkg_msg({_sender}, "download failed for %{_url}%")
        stop
    Files.write(Path.of({-pacskage::self_path}), {_bytes}, {-pacskage::write_options})
    pkg_msg({_sender}, "updated pacskage - /sk reload package.sk to apply")

local function pkg_usage(to: Object):
    pkg_msg({_to}, "commands (click one to use it):")
    for {_entry} in {-pacskage::commands::*}:
        set {_cmd} to first_word({_entry})
        pkg_msg({_to}, "  <click:suggest_command:/package %{_cmd}% >{@link}/package %{_entry}%</click>{@body}")

local function pkg_list_report(sender: Object):
    set {_packages::*} to pkg_list()
    if {_packages::*} is not set:
        pkg_msg({_sender}, "no packages installed")
        stop
    set {_display::*} to ({_packages::*} transformed with [pkg_display(input)])
    pkg_msg({_sender}, "installed packages (%size of {_display::*}%): %{_display::*}%")

local function pkg_check_report(sender: Object):
    set {_folders::*} to pkg_list()
    if {_folders::*} is not set:
        pkg_msg({_sender}, "no packages installed")
        stop
    pkg_msg({_sender}, "checking %size of {_folders::*}% package(s)...")
    for {_folder} in {_folders::*}:
        pkg_msg({_sender}, pkg_check_line({_folder}))

local function pkg_outdated_report(sender: Object):
    set {_folders::*} to pkg_list()
    if {_folders::*} is not set:
        pkg_msg({_sender}, "no packages installed")
        stop
    pkg_msg({_sender}, "checking %size of {_folders::*}% package(s) for updates...")
    for {_folder} in {_folders::*}:
        pkg_msg({_sender}, pkg_outdated_line({_folder}))

local function pkg_awesome(sender: Object):
    set {_link} to pkg_link("awesome-pacskage", "https://github.com/miberss/awesome-pacskage")
    pkg_msg({_sender}, "%{_link}% is a community list of packages to install")
    pkg_msg({_sender}, "find one you like, then /package install <its git url>")

local function pkg_update_report(sender: Object, name: String):
    pkg_msg({_sender}, "updating %{_name}% from its origin...")
    set {_status} to pkg_update({_name})
    pkg_msg({_sender}, {_status} ? pkg_error("update failed"))
    pkg_reorder({_sender})

local function pkg_remove_report(sender: Object, name: String):
    set {_dest} to pkg_resolve({_name})
    if {_dest} is not set:
        pkg_msg({_sender}, "package %{_name}% is not installed")
        stop
    dir_delete({_dest})
    pkg_msg({_sender}, "removed %{_name}% - /sk reload scripts to apply")
    pkg_reorder({_sender})

local function pkg_enable_report(sender: Object, name: String):
    set {_folder} to pkg_find_folder({_name})
    if {_folder} is not set:
        pkg_msg({_sender}, "package %{_name}% is not installed")
        stop
    if {_folder} does not start with "-":
        pkg_msg({_sender}, "package %{_name}% is already enabled")
        stop
    set {_missing::*} to pkg_missing(pkg_dir({_folder}))
    if {_missing::*} is set:
        pkg_msg({_sender}, "cannot enable %{_name}%, missing: %{_missing::*}%")
        stop
    dir_rename(pkg_dir({_folder}), pkg_dir(sub({_folder}, 2)))
    pkg_msg({_sender}, "enabled %{_name}% - /sk reload scripts to apply")
    pkg_reorder({_sender})

local function pkg_disable_report(sender: Object, name: String):
    set {_folder} to pkg_find_folder({_name})
    if {_folder} is not set:
        pkg_msg({_sender}, "package %{_name}% is not installed")
        stop
    if {_folder} starts with "-":
        pkg_msg({_sender}, "package %{_name}% is already disabled")
        stop
    dir_rename(pkg_dir({_folder}), pkg_disabled_dir({_folder}))
    pkg_msg({_sender}, "disabled %{_name}% - /sk reload scripts to apply")
    pkg_reorder({_sender})

local function pkg_info_requirements(sender: Object, lines: Strings):
    set {_requires} to manifest_value({_lines::*}, "requires")
    if {_requires} is set:
        pkg_msg({_sender}, "requires:")
        for {_entry} in split {_requires} at ",":
            pkg_msg({_sender}, requirement_status({_entry}))
    set {_packages} to manifest_value({_lines::*}, "packages")
    if {_packages} is not set:
        stop
    pkg_msg({_sender}, "packages:")
    for {_entry} in split {_packages} at ",":
        pkg_msg({_sender}, pkg_dep_status({_entry}))

local function pkg_info_report(sender: Object, name: String):
    set {_dir} to pkg_resolve({_name})
    if {_dir} is not set:
        pkg_msg({_sender}, "package %{_name}% is not installed")
        stop
    set {_lines::*} to manifest_lines({_dir})
    set {_origin} to manifest_value({_lines::*}, "origin")
    set {_title} to (manifest_value({_lines::*}, "name") ? {_name})
    set {_version} to manifest_value({_lines::*}, "version")
    set {_state} to ""
    if pkg_find_folder({_name}) starts with "-":
        set {_state} to " (disabled)"
    set {_suffix} to ""
    if {_version} is set:
        set {_suffix} to " v%{_version}%"
    pkg_msg({_sender}, "package: %pkg_link({_title}, {_origin})%%{_suffix}%%{_state}%")
    set {_description} to manifest_value({_lines::*}, "description")
    if {_description} is set:
        pkg_msg({_sender}, "description: %{_description}%")
    if {_origin} is set:
        pkg_msg({_sender}, "origin: %pkg_link({_origin}, {_origin})%")
    pkg_info_requirements({_sender}, {_lines::*})

command /package:
    condition:
        return whether sender has permission "pacskage.admin"
    subcommand install <url: string>:
        trigger:
            pkg_install_report(sender, {_url})
            pkg_reorder(sender)
    subcommand update <name: word>:
        trigger:
            pkg_update_report(sender, {_name})
    subcommand remove <name: word>:
        trigger:
            pkg_remove_report(sender, {_name})
    subcommand enable <name: word>:
        trigger:
            pkg_enable_report(sender, {_name})
    subcommand disable <name: word>:
        trigger:
            pkg_disable_report(sender, {_name})
    subcommand info <name: word>:
        trigger:
            pkg_info_report(sender, {_name})
    subcommand list:
        trigger:
            pkg_list_report(sender)
    subcommand check:
        trigger:
            pkg_check_report(sender)
    subcommand outdated:
        trigger:
            pkg_outdated_report(sender)
    subcommand selfupdate:
        trigger:
            pkg_selfupdate(sender)
    subcommand awesome:
        trigger:
            pkg_awesome(sender)
    trigger:
        pkg_usage(sender)
